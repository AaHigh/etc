#!/bin/tcsh
# this will only install dotfiles if you do not already have them,
# and if you do, then it will simply tell you that it won't
# overwrite what you have there....
#
if( ! -f $HOME/.profile ) then
    cp -f _bashrc $HOME/.profile
else
    echo "already have a .profile in your home directory!"
endif

if( ! -f $HOME/.vimrc ) then
    cp -f _vimrc $HOME/.vimrc
else
    echo "already have a .vimrc in your home directory!"
endif

if( ! -f $HOME/.tcshrc ) then
    cp -f _tcshrc $HOME/.tcshrc
else
    echo "already have a .tcshrc in your home directory!"
endif

if( ! -f /bin/t ) then
    cp -f t /bin/t
    echo "installed the /bin/t to exec tcsh with a single letter cmd"
else
    echo "already have a /bin/t (if same size it's prob fine.)"
    echo "here are the two files' details"
    ls -ld ./t /bin/t
endif

echo "NOTE: replacement does not happen automatically.
echo "      rm -f <filename> for any file that appears outdated"
echo "      this script is really only intended to run once"
